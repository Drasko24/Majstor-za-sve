generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  PROVIDER
  CLIENT
  ADMIN
}

enum LabelStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum ModerationAction {
  APPROVED
  REJECTED
  MERGED
}

enum ImageEntityType {
  PROVIDER_GALLERY
  PORTFOLIO
  REQUEST
}

/// SERVICE = treba mi da se odradi posao; PURCHASE = trazim da kupim artikal.
enum RequestType {
  SERVICE
  PURCHASE
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  providerProfile  ProviderProfile?
  reviewsWritten   Review[]           @relation("ClientReviews")
  requestedLabels  Label[]
  moderationLogs   LabelModerationLog[]
  jobRequests      JobRequest[]       @relation("AuthoredRequests")

  @@map("users")
}

model ProviderProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  displayName    String   @map("display_name")
  bio            String?
  yearsExperience Int?    @map("years_experience")
  city           String
  municipality   String?
  phone          String?
  phoneVisible   Boolean  @default(false) @map("phone_visible")
  emailVisible   Boolean  @default(false) @map("email_visible")
  isAvailable    Boolean  @default(true) @map("is_available")
  avgRating      Decimal? @map("avg_rating") @db.Decimal(3, 2)
  reviewCount    Int      @default(0) @map("review_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  labels         ProviderLabel[]
  portfolioItems PortfolioItem[]
  images         Image[]          @relation("ProviderGallery")
  reviews        Review[]         @relation("ProviderReviews")
  offers         Offer[]

  @@map("provider_profiles")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryTree")
  labels      Label[]
  jobRequests JobRequest[]

  @@map("categories")
}

model Label {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  categoryId  Int         @map("category_id")
  status      LabelStatus @default(PENDING)
  requestedBy String?     @map("requested_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  category        Category             @relation(fields: [categoryId], references: [id])
  requester       User?                @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  providers       ProviderLabel[]
  moderationLogs  LabelModerationLog[]
  mergedIntoLogs  LabelModerationLog[] @relation("MergedLabel")
  jobRequests     RequestLabel[]

  @@map("labels")
}

model ProviderLabel {
  providerId String @map("provider_id")
  labelId    Int    @map("label_id")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label    Label           @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([providerId, labelId])
  @@map("provider_labels")
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  providerId  String   @map("provider_id")
  title       String
  description String?
  year        Int?
  createdAt   DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  images   Image[]         @relation("PortfolioImages")

  @@map("portfolio_items")
}

model Image {
  id           Int             @id @default(autoincrement())
  entityType   ImageEntityType @map("entity_type")
  providerId   String?         @map("provider_id")
  portfolioId  Int?            @map("portfolio_id")
  requestId    Int?            @map("request_id")
  url          String
  displayOrder Int             @default(0) @map("display_order")
  fileSize     Int?            @map("file_size")
  createdAt    DateTime        @default(now()) @map("created_at")

  provider   ProviderProfile? @relation("ProviderGallery", fields: [providerId], references: [id], onDelete: Cascade)
  portfolio  PortfolioItem?   @relation("PortfolioImages", fields: [portfolioId], references: [id], onDelete: Cascade)
  jobRequest JobRequest?      @relation("RequestImages", fields: [requestId], references: [id], onDelete: Cascade)

  @@map("images")
}

model Review {
  id         Int      @id @default(autoincrement())
  providerId String   @map("provider_id")
  clientId   String   @map("client_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  provider ProviderProfile @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)
  client   User            @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([providerId, clientId])
  @@map("reviews")
}

model LabelModerationLog {
  id                 Int              @id @default(autoincrement())
  labelId            Int              @map("label_id")
  adminId            String           @map("admin_id")
  action             ModerationAction
  mergedWithLabelId  Int?             @map("merged_with_label_id")
  note               String?
  decidedAt          DateTime         @default(now()) @map("decided_at")

  label          Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  admin          User   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  mergedWithLabel Label? @relation("MergedLabel", fields: [mergedWithLabelId], references: [id], onDelete: SetNull)

  @@map("label_moderation_log")
}

/// Oglas koji postavlja narucilac: "treba mi kuhinja" (SERVICE) ili
/// "trazim da kupim macbook" (PURCHASE). Majstori/prodavci salju ponude.
model JobRequest {
  id             Int           @id @default(autoincrement())
  authorId       String        @map("author_id")
  type           RequestType   @default(SERVICE)
  title          String
  description    String
  categoryId     Int?          @map("category_id")
  city           String
  municipality   String?
  budgetMin      Decimal?      @map("budget_min") @db.Decimal(10, 2)
  budgetMax      Decimal?      @map("budget_max") @db.Decimal(10, 2)
  deadline       DateTime?     @db.Date
  contactPhone   String?       @map("contact_phone")
  contactVisible Boolean       @default(true) @map("contact_visible")
  status         RequestStatus @default(OPEN)
  viewCount      Int           @default(0) @map("view_count")
  offerCount     Int           @default(0) @map("offer_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  author   User           @relation("AuthoredRequests", fields: [authorId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  labels   RequestLabel[]
  images   Image[]        @relation("RequestImages")
  offers   Offer[]

  @@index([status, createdAt])
  @@index([city])
  @@map("requests")
}

model RequestLabel {
  requestId Int @map("request_id")
  labelId   Int @map("label_id")

  jobRequest JobRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  label      Label      @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([requestId, labelId])
  @@map("request_labels")
}

/// Ponuda majstora na oglas. Jedan majstor - jedna ponuda po oglasu.
model Offer {
  id         Int         @id @default(autoincrement())
  requestId  Int         @map("request_id")
  providerId String      @map("provider_id")
  price      Decimal?    @db.Decimal(10, 2)
  message    String
  daysToDone Int?        @map("days_to_done")
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  jobRequest JobRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@map("offers")
}
